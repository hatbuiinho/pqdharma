# Dedicated database/user on the existing posgres container. URL-encode the password.
DATABASE_URL=postgres://pqdharma:CHANGE_ME@posgres:5432/pqdharma?sslmode=disable

WHISPER_MODEL=small.en
CPU_THREADS=2
TRANSCRIBER_CPUS=2
TRANSCRIBER_MEMORY=4g

# Leave endpoint empty to keep local storage. Never commit real credentials.
S3_ENDPOINT=
# S3_ENDPOINT=https://minio-api.hatbuinho.me
S3_BUCKET=pqdharma
S3_PREFIX=prod
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# Optional reviewed IPA overrides inside the API container.
# IPA_OVERRIDES=/data/phonetic-overrides.json

# Local English speech synthesis (CPU, one turn at a time).
TTS_CPU_THREADS=2
TTS_CPUS=2
TTS_MEMORY=2g

# Only needed with compose.local.yaml; use a generated local admin password.
# LOCAL_POSTGRES_PASSWORD=replace-with-a-random-local-password
# Local application URL after creating its role/database:
# DATABASE_URL=postgres://pqdharma_local:APP_PASSWORD@pq-dharma-local-postgres:5432/pqdharma_local?sslmode=disable

# Public HTTPS origin used in recording share previews.
PUBLIC_ORIGIN=https://pqdharma.hatbuinho.me

# Bootstrap admin once; existing passwords are never overwritten.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
