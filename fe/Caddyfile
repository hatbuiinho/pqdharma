{
 auto_https off
 admin off
}

:3000 {
 root * /srv
 encode zstd gzip

 @api path /api /api/*
 handle @api {
  reverse_proxy {$API_ORIGIN:http://pq-dharma-api:8080}
 }

 handle {
  @immutable path /_app/immutable/*
  header @immutable Cache-Control "public, max-age=31536000, immutable"

  @fresh path / /index.html /service-worker.js /_app/version.json
  header @fresh Cache-Control "no-cache"

  route {
   @page {
    not path /api /api/* /_app/* /icons/* /branding/* /service-worker.js /manifest.webmanifest
    not file {path}
   }
   rewrite @page /index.html
   header /index.html Cache-Control "no-cache"
   file_server
  }
 }
}
